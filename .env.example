# Copy to .env and fill in. Do not commit your real .env.
#
# ALMOST EVERYTHING here is now optional. All of the AWS wiring, AWS credentials,
# the app title, and OIDC/SSO can be configured through the UI at /settings and
# are persisted to CONFIG_FILE. The variables below are only initial SEEDS: once
# you save in the UI the stored config wins. The one thing you MUST set is
# ADMIN_TOKEN (it unlocks /settings). SESSION_SECRET / SECURE_COOKIES / CONFIG_FILE
# stay here too because they can't be configured through the page they enable.
#
# So the minimal .env is just: ADMIN_TOKEN (+ SESSION_SECRET), then do the rest
# at /settings. Everything below is provided for convenience / unattended setup.

# ── Operational seeds (or set these at /settings) ───────────────────────────
AWS_DEFAULT_REGION=us-east-1
TABLE_NAME=demoworldfun-messages
DYNAMODB_INDEX=global-index
BUCKET_NAME=your-inbox-bucket
S3_PREFIX=inbox/
APP_TITLE=inbox

# ── AWS credentials seeds (or set these at /settings) ───────────────────────
# Leave blank to use an instance/task role or a mounted ~/.aws instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary/SSO credentials:
AWS_SESSION_TOKEN=

# ── Auth: OpenID Connect SSO (Authentik) ────────────────────────────────────
# OIDC is configured through the UI at /settings. The variables below still work
# as initial seeds; once you save in the UI, the stored config takes precedence.
#
# ADMIN_TOKEN unlocks the setup wizard / settings page. It is now OPTIONAL:
#   - Leave it BLANK and the app generates a strong admin key on first boot,
#     shows it once in the browser AND prints it once to the container log, and
#     stores only a hash. Lost it? Regenerate from the CLI (the only recovery):
#         docker exec <container> python app.py reset-admin-key
#   - Or SET it here to pin the admin key to a fixed value you manage yourself.
ADMIN_TOKEN=

# Optional seeds (or configure all of these at /settings after first boot):
OIDC_DISCOVERY_URL=https://authtime.trevorcombs.com/application/o/<app-slug>/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must EXACTLY match the redirect URI registered in Authentik:
OIDC_REDIRECT_URI=https://your-app-host/auth/callback
# Optional: comma-separated provider groups allowed in (blank = any user):
OIDC_ALLOWED_GROUPS=
# Signs the local session cookie (and the admin unlock). Set it so the unlock
# survives restarts. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Set true whenever served over HTTPS (marks the session cookie Secure):
SECURE_COOKIES=true

# Set true to run with NO login (local dev, or behind another auth proxy).
# You can also toggle this from /settings ("Require SSO login").
AUTH_DISABLED=

# Where UI-entered settings are persisted. Defaults to /data/config.json inside
# the container; the compose file mounts a volume there so it survives restarts.
CONFIG_FILE=/data/config.json

# ── Compose only ────────────────────────────────────────────────────────────
HOST_PORT=8100
